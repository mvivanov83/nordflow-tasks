# Порт приложения (Railway задаёт автоматически)
PORT=3000

# Секрет для подписи JWT. В продакшене задайте случайное значение.
JWT_SECRET=change-me-to-a-random-long-string

# PostgreSQL (необязательно). Если задан — используется вместо SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/nordflow
# DATABASE_SSL=true

# Путь к файлу SQLite (необязательно)
# DATABASE_FILE=./data/nordflow.db
