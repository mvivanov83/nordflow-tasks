{
  "name": "nordflow-tasks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NordFlow Tasks — внутренний трекер проектов и задач",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "npm run build && node server/index.js",
    "serve": "node server/index.js",
    "build": "vite build",
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "seed": "node server/seed.js --force"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.4"
  }
}
